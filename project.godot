; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ascension"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/globals/game_manager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
GameState="*res://scripts/game_state.gd"

[dialogue_manager]

runtime/balloon_path="res://ui/balloon.tscn"

[dotnet]

project/assembly_name="Ascension"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

